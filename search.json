---
layout: null
permalink: /search.json
---
[
{% for post in site.posts %}{
  "t": {{ post.title | jsonify }},
  "u": {{ post.url | relative_url | jsonify }},
  "d": {{ post.date | date: "%Y-%m-%d" | jsonify }},
  "g": {{ post.tags | jsonify }},
  "s": {{ post.description | default: "" | strip_newlines | jsonify }},
  "b": {{ post.content | strip_html | normalize_whitespace | truncate: 8000 | jsonify }}
}{% unless forloop.last %},{% endunless %}
{% endfor %}]
